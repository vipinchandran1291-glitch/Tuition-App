<%- include('partials/header') %>
<% const s = student; const pct = (a) => a.total ? Math.round(a.present / a.total * 100) : null; %>
<div class="stack">
  <div class="card">
    <div class="profile-head">
      <div class="avatar"><%= s.name.split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase() %></div>
      <div style="flex: 1; min-width: 0">
        <h1><%= s.name %> <% if (!s.active) { %><span class="pill muted">Left</span><% } %></h1>
        <div class="text-muted">Class <%= s.grade %>-<%= s.division %><%= s.roll_no ? ' · Roll ' + s.roll_no : '' %> · ₹<%= u.money(s.monthly_fee) %>/month</div>
      </div>
    </div>

    <div class="due-box <%= led.pending > 0 ? 'bad' : 'good' %>" style="margin-top: 16px">
      <div>
        <div class="text-muted" style="font-size: .8rem; font-weight: 600"><%= led.pending > 0 ? 'PENDING AMOUNT' : led.pending < 0 ? 'ADVANCE CREDIT' : 'FEES' %></div>
        <div class="amt num <%= led.pending > 0 ? 'text-bad' : 'text-good' %>"><%= led.pending === 0 ? 'All paid' : '₹' + u.money(Math.abs(led.pending)) %></div>
        <div class="text-muted" style="font-size: .8rem">Total charged ₹<%= u.money(led.totalDue) %> · Paid ₹<%= u.money(led.totalPaid) %></div>
      </div>
      <% if (s.active) { %><a class="btn btn-primary" href="/collect?student=<%= s.id %>">Collect Fee</a><% } %>
    </div>

    <% if (led.unpaidMonths.length) { %>
      <div style="margin-top: 12px">
        <div class="text-muted" style="font-size: .8rem; margin-bottom: 6px">Unpaid months</div>
        <div class="months">
          <% led.unpaidMonths.forEach(m => { %>
            <span class="pill <%= m.status === 'partial' ? 'warn' : 'bad' %>"><%= m.label %><%= m.status === 'partial' ? ' · ₹' + u.money(m.balance) + ' left' : '' %></span>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="btn-row" style="margin-top: 16px">
      <% if (s.phone) { %>
        <a class="btn btn-sm" href="tel:<%= s.phone %>">Call</a>
        <a class="btn btn-sm" target="_blank" rel="noopener" href="https://wa.me/<%= u.waPhone(s.phone) %>">WhatsApp</a>
      <% } %>
      <a class="btn btn-sm" href="/students/<%= s.id %>/edit">Edit</a>
    </div>
  </div>

  <div class="grid grid-2">
    <div class="card flush">
      <div class="card-head"><h2>Payment receipts</h2><span class="text-muted"><%= payments.length %></span></div>
      <% if (!payments.length) { %>
        <div class="empty">No payments yet.</div>
      <% } else { %>
        <ul class="list" style="margin-top: 8px">
          <% payments.forEach(p => { %>
            <li class="list-item">
              <a class="grow" href="/payments/<%= p.id %>" style="color: inherit">
                <div class="title num">₹<%= u.money(p.amount) %> <span class="text-muted" style="font-weight: 400">· <%= p.mode %></span></div>
                <div class="meta"><%= u.receiptNo(p) %> · <%= u.dateLabel(p.paid_on) %></div>
                <div class="meta"><%= p.months_covered %></div>
              </a>
              <a class="btn btn-sm" href="/payments/<%= p.id %>/receipt.pdf">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>PDF
              </a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="stack">
      <div class="card">
        <div class="card-head"><h2>Attendance</h2>
          <span class="text-muted"><%= pct(overall) === null ? 'No records' : `Overall ${pct(overall)}%` %></span></div>
        <table>
          <thead><tr><th>Month</th><th class="r">Present</th><th class="r">%</th></tr></thead>
          <tbody>
            <% attendance.forEach(a => { %>
              <tr><td><%= a.label %></td><td class="r num"><%= a.present %>/<%= a.total %></td>
                <td class="r"><% if (pct(a) === null) { %>–<% } else { %><span class="pill <%= pct(a) >= 85 ? 'good' : pct(a) >= 70 ? 'warn' : 'bad' %>"><%= pct(a) %>%</span><% } %></td></tr>
            <% }) %>
          </tbody>
        </table>
        <% if (absences.length) { %>
          <div class="text-muted" style="font-size: .8rem; margin: 12px 0 6px">Recent absences</div>
          <div class="months"><% absences.forEach(a => { %><span class="pill muted"><%= u.dateLabel(a.date) %></span><% }) %></div>
        <% } %>
      </div>

      <div class="card">
        <div class="card-head"><h2>Details</h2></div>
        <dl class="kv">
          <dt>Parent</dt><dd><%= s.parent_name || '–' %></dd>
          <dt>Phone</dt><dd><%= s.phone || '–' %></dd>
          <dt>Address</dt><dd><%= s.address || '–' %></dd>
          <dt>Joined</dt><dd><%= u.dateLabel(s.join_date) %></dd>
          <dt>Fees from</dt><dd><%= u.monthLabel(s.fee_start) %></dd>
          <% if (s.left_on) { %><dt>Left on</dt><dd><%= u.dateLabel(s.left_on) %></dd><% } %>
        </dl>
        <div class="btn-row" style="margin-top: 16px">
          <form method="post" action="/students/<%= s.id %>/active" onsubmit="return confirm('<%= s.active ? 'Mark this student as left? No new monthly fees will be added.' : 'Re-activate this student?' %>')">
            <button class="btn btn-sm"><%= s.active ? 'Mark as left' : 'Re-activate' %></button>
          </form>
          <% if (!payments.length) { %>
            <form method="post" action="/students/<%= s.id %>/delete" onsubmit="return confirm('Delete this student permanently?')">
              <button class="btn btn-sm btn-danger">Delete</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
