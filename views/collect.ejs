<%- include('partials/header') %>
<div class="page-head"><h1>Collect Fee</h1></div>

<% if (!selected) { %>
  <div class="card flush">
    <div style="padding: 12px">
      <input type="search" id="q" placeholder="Search student by name, class or phone" autofocus autocomplete="off">
    </div>
    <ul class="list search-results" id="results">
      <% students.forEach(s => { %>
        <li data-search="<%= (s.name + ' ' + s.grade + '-' + s.division + ' ' + s.grade + s.division + ' ' + (s.phone || '')).toLowerCase() %>">
          <a class="list-item" href="/collect?student=<%= s.id %>">
            <div class="avatar"><%= s.name.split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase() %></div>
            <div class="grow">
              <div class="title"><%= s.name %></div>
              <div class="meta">Class <%= s.grade %>-<%= s.division %><%= s.roll_no ? ' · Roll ' + s.roll_no : '' %></div>
            </div>
            <div class="end">
              <% if (s.pending > 0) { %><span class="pill bad num">₹<%= u.money(s.pending) %></span><% } else { %><span class="pill good">Paid</span><% } %>
            </div>
          </a>
        </li>
      <% }) %>
    </ul>
    <div class="empty" id="noresults" hidden>No matching students.</div>
    <% if (!students.length) { %><div class="empty">No students yet. <a href="/students/new">Add one</a></div><% } %>
  </div>
<% } else { %>
  <% const s = selected; const suggested = led.pending > 0 ? led.pending : s.monthly_fee; %>
  <form method="post" action="/collect" class="card" style="max-width: 560px" id="collect-form">
    <input type="hidden" name="student_id" value="<%= s.id %>">
    <div class="collect-student">
      <div class="avatar"><%= s.name.split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase() %></div>
      <div style="flex: 1; min-width: 0">
        <div style="font-weight: 700"><%= s.name %></div>
        <div class="text-muted" style="font-size: .85rem">Class <%= s.grade %>-<%= s.division %> · ₹<%= u.money(s.monthly_fee) %>/month</div>
      </div>
      <a class="btn btn-sm" href="/collect">Change</a>
    </div>

    <div class="due-box <%= led.pending > 0 ? 'bad' : 'good' %>" style="margin: 14px 0">
      <div>
        <div class="text-muted" style="font-size: .8rem; font-weight: 600"><%= led.pending > 0 ? 'PENDING' : led.pending < 0 ? 'ADVANCE CREDIT' : 'NO DUES' %></div>
        <div class="amt num <%= led.pending > 0 ? 'text-bad' : 'text-good' %>">₹<%= u.money(Math.abs(led.pending)) %></div>
      </div>
      <% if (led.unpaidMonths.length) { %>
        <div class="months" style="justify-content: flex-end">
          <% led.unpaidMonths.slice(0, 6).forEach(m => { %><span class="pill <%= m.status === 'partial' ? 'warn' : 'bad' %>"><%= m.label %></span><% }) %>
          <% if (led.unpaidMonths.length > 6) { %><span class="pill muted">+<%= led.unpaidMonths.length - 6 %></span><% } %>
        </div>
      <% } %>
    </div>

    <div class="field">
      <label for="amount">Amount (₹)</label>
      <input id="amount" class="input-money num" type="number" name="amount" min="1" step="1" inputmode="numeric" value="<%= suggested %>" required>
      <div class="btn-row" style="margin-top: 8px">
        <% if (led.pending > 0) { %><button type="button" class="btn btn-sm" data-amount="<%= led.pending %>">Full ₹<%= u.money(led.pending) %></button><% } %>
        <% [1, 2, 3].forEach(n => { %><button type="button" class="btn btn-sm" data-amount="<%= s.monthly_fee * n %>"><%= n %> month<%= n > 1 ? 's' : '' %></button><% }) %>
      </div>
    </div>

    <div class="field">
      <label>Payment mode</label>
      <div class="segmented">
        <% modes.forEach((m, i) => { %>
          <input type="radio" name="mode" id="mode-<%= m %>" value="<%= m %>" <%= i === 0 ? 'checked' : '' %>><label for="mode-<%= m %>"><%= m %></label>
        <% }) %>
      </div>
    </div>

    <div class="grid grid-2">
      <div class="field">
        <label for="paid_on">Date</label>
        <input id="paid_on" type="date" name="paid_on" value="<%= u.today() %>" max="<%= u.today() %>">
      </div>
      <div class="field">
        <label for="note">Note (optional)</label>
        <input id="note" type="text" name="note" placeholder="e.g. UPI ref no.">
      </div>
    </div>

    <button class="btn btn-primary btn-lg" id="save-btn">Save payment</button>
  </form>
<% } %>
<%- include('partials/footer') %>
